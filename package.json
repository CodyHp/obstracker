{
  "name": "mindtrace",
  "version": "1.4.3",
  "description": "Local-first attention analytics for Obsidian: track time and writing per note, visualized by topic and time.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "time-tracking",
    "analytics"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "echarts": "^6.1.0"
  }
}
